{
  "name": "@agentor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentor/billing": "workspace:*",
    "@agentor/connectors": "workspace:*",
    "@agentor/db": "workspace:*",
    "@agentor/jobs": "workspace:*",
    "@agentor/keybox": "workspace:*",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@agentor/config": "workspace:*",
    "tsx": "^4.0.0",
    "vitest": "^4.0.0"
  }
}
