# Names only. Copy to .env.local for development; production values live in
# .env.production outside the webroot, mode 0400, one file per OS user (produktspecifikation §10.5).
# Never put real values in this file.

# --- URLs ---------------------------------------------------------------------------------
# Public origin of the web app. Production: https://app.agentor.dk
APP_URL=http://localhost:3000

# --- PostgreSQL (one URL per role, produktspecifikation §10.3) ------------------------------
# Superuser: local tests only (creates throwaway databases). Never set in production.
DATABASE_ADMIN_URL=
# Migrations only (deploy pipeline).
DATABASE_URL_OWNER=
# agentor-app and agentor-ingest.
DATABASE_URL_WEB=
# agentor-worker and agentor-scheduler.
DATABASE_URL_WORKER=
# Isolation tests only.
DATABASE_URL_SUPPORT=
DATABASE_URL_OPS=

# --- Redis (dedicated instance, noeviction + AOF) ------------------------------------------
REDIS_URL=

# --- Key box (worker only) ------------------------------------------------------------------
# Path to the key encryption key file, outside the repo and webroot, owned by agentor-worker, 0400.
KEK_FILE=
# Web only: the KEK's public half (base64, 32 bytes). Seals credentials the web can't read.
# Development pair: node infra/scripts/dev-kek.mjs >> .env.local
KEK_PUBLIC_KEY=
# mock (fictional data, Fase 1) | live (when a connector's live client ships)
CONNECTOR_MODE=mock

# --- Auth (Better Auth, M2) -------------------------------------------------------------------
BETTER_AUTH_SECRET=
# Sign-up and login with Google and Microsoft (PLAN-SIGNUP §5).
# off | mock (local test identity provider at /dev/oauth, never in production) | live
SSO_MODE=off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Terms accepted at payment (served from agentor.dk, PLAN-SIGNUP B6/B12) ----------------
LEGAL_SUBSCRIPTION_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_DPA_URL=
# Development and tests only, while agentor.dk has no documents yet.
LEGAL_DEV_VERSION=

# --- E-mail and SMS (Brevo; Mailpit locally) --------------------------------------------------
SMTP_URL=
BREVO_API_KEY=
# Sender of every e-mail (web and worker).
MAIL_FROM=Agentor <no-reply@agentor.dk>
# Inbound domain for replies to resolved cases (E12): Reply-To sag+<token>@<domain>. Its MX must
# point at Brevo Inbound Parsing, which posts to agentor-ingest /mail/inbound with the secret
# below. Leave empty to send replies to support@agentor.dk instead.
CASE_REPLY_DOMAIN=
INBOUND_MAIL_SECRET=

# --- Payments (QuickPay) -----------------------------------------------------------------------
# mock (local/e2e, no network) | test (QuickPay test merchant) | live
QUICKPAY_MODE=mock
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=
# Public URL QuickPay posts callbacks to (agentor-ingest), and how web/worker reach ingest internally.
INGEST_PUBLIC_URL=http://127.0.0.1:3100
INGEST_INTERNAL_URL=http://127.0.0.1:3100

# --- CVR lookup --------------------------------------------------------------------------------
# fixture (fictional companies, development) | virkdata (https://virkdata.dk, key under API Nøgler)
CVR_PROVIDER=fixture
VIRKDATA_API_KEY=

# --- Processes ----------------------------------------------------------------------------------
INGEST_HOST=127.0.0.1
INGEST_PORT=3100
LOG_LEVEL=info

# --- Web Push (PLAN-MOBILE M3) -----------------------------------------------------------------
# Generate once per environment: node -e "console.log(require('web-push').generateVAPIDKeys())"
# (run in apps/worker). The public key is sent to browsers; the private key stays on the server.
# Without both, push is off and MA11 says so.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@agentor.dk

# Storage area for uploaded files (profile photos). Production: /var/lib/agentor/storage
# STORAGE_DIR=
